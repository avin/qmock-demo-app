{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "endOfLine": "lf",
  "arrowParens": "always",
  "bracketSpacing": true,
  "sortImports": {
    "internalPattern": ["@/"],
    "newlinesBetween": false
  },
  "sortTailwindcss": true,
  "ignorePatterns": [
    "dist",
    "dist-ssr",
    "coverage",
    "node_modules",
    "storybook-static",
    "playwright-report",
    "test-results",
    "blob-report",
    "src/plugins/samsung-pay/lib/vendor"
  ]
}
